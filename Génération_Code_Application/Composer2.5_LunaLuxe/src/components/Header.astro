---
import CartButton from '@/components/solid/CartButton';
import AuthNav from '@/components/AuthNav.astro';
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-luna-200/60 bg-luna-50/80 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="font-serif text-2xl font-semibold tracking-wide text-luna-900">
      Luna<span class="text-lavender-500">Luxe</span>
    </a>

    <nav class="hidden items-center gap-8 text-sm font-medium text-luna-700 md:flex">
      <a href="/catalog" class="transition-colors hover:text-luna-900">Catalog</a>
      <a href="/cart" class="transition-colors hover:text-luna-900">Cart</a>
      <a href="#collections" class="transition-colors hover:text-luna-900">Collections</a>
      <a href="#about" class="transition-colors hover:text-luna-900">Our Story</a>
    </nav>

    <div class="flex items-center gap-4">
      <AuthNav />
      <CartButton client:load />
    </div>
  </div>
</header>
