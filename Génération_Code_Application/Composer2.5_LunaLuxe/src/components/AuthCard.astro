---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="mx-auto w-full max-w-md">
  <div class="rounded-2xl border border-luna-200 bg-white p-8 shadow-sm">
    <h1 class="font-serif text-3xl font-semibold text-luna-900">{title}</h1>
    {subtitle && <p class="mt-2 text-sm text-luna-600">{subtitle}</p>}
    <div class="mt-8">
      <slot />
    </div>
  </div>
</div>
