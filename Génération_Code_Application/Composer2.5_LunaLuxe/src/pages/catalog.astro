---
export const prerender = false;

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CartDrawer from '@/components/solid/CartDrawer';
import CatalogFilters from '@/components/catalog/CatalogFilters.astro';
import ProductCard from '@/components/ProductCard.astro';
import Alert from '@/components/Alert.astro';
import { searchProducts, type ProductSort } from '@/lib/products';
import { getAllProductRatingSummaries } from '@/lib/reviews';

const params = Astro.url.searchParams;
const q = params.get('q') ?? '';
const category = params.get('category') ?? '';
const minPriceRaw = params.get('minPrice') ?? '';
const maxPriceRaw = params.get('maxPrice') ?? '';
const featuredOnly = params.get('featured') === '1';
const sort = (params.get('sort') as ProductSort) || 'newest';
const error = params.get('error');

const minPrice = minPriceRaw ? Number(minPriceRaw) : undefined;
const maxPrice = maxPriceRaw ? Number(maxPriceRaw) : undefined;

const validSorts: ProductSort[] = ['newest', 'price-asc', 'price-desc', 'name'];
const activeSort = validSorts.includes(sort) ? sort : 'newest';

const [products, ratingMap] = await Promise.all([
  searchProducts({
    q,
    category: category || undefined,
    minPrice: Number.isFinite(minPrice) ? minPrice : undefined,
    maxPrice: Number.isFinite(maxPrice) ? maxPrice : undefined,
    featuredOnly,
    sort: activeSort,
  }),
  getAllProductRatingSummaries(),
]);
---

<BaseLayout title="Product Catalog — LunaLuxe" description="Browse silk sleep masks, bamboo sheets, and weighted blankets. Search and filter our full collection.">
  <Header />
  <CartDrawer client:load />

  <main class="mx-auto max-w-6xl px-6 pb-24 pt-28">
    <div class="mb-8">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-lavender-500">Shop</p>
      <h1 class="mt-2 font-serif text-4xl font-semibold text-luna-900 md:text-5xl">Product catalog</h1>
      <p class="mt-3 max-w-2xl text-luna-600">
        Explore our full collection of sleep essentials. Use search and filters to find your perfect match.
      </p>
    </div>

    <Alert type="error" message={error} />

    <div class="mb-8">
      <CatalogFilters
        q={q}
        category={category}
        minPrice={minPriceRaw}
        maxPrice={maxPriceRaw}
        featuredOnly={featuredOnly}
        sort={activeSort}
        resultCount={products.length}
      />
    </div>

    {products.length === 0 ? (
      <div class="rounded-2xl border border-luna-200 bg-luna-50 px-6 py-16 text-center">
        <p class="font-serif text-xl text-luna-800">No products match your filters</p>
        <p class="mt-2 text-sm text-luna-500">Try adjusting your search or clearing filters.</p>
        <a href="/catalog" class="mt-6 inline-block text-sm font-medium text-lavender-600 hover:text-lavender-500">
          View all products
        </a>
      </div>
    ) : (
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((product) => (
          <ProductCard product={product} rating={ratingMap.get(product.id)} />
        ))}
      </div>
    )}
  </main>

  <Footer />
</BaseLayout>
