---
export const prerender = false;

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CartDrawer from '@/components/solid/CartDrawer';
import Alert from '@/components/Alert.astro';
import ReviewForm from '@/components/reviews/ReviewForm.astro';
import ReviewList from '@/components/reviews/ReviewList.astro';
import AddToCartButton from '@/components/solid/AddToCartButton';
import { getProductBySlug } from '@/lib/products';
import {
  getReviewsByProductId,
  getProductRatingSummary,
  getUserReviewForProduct,
} from '@/lib/reviews';
import { formatCurrency } from '@/lib/format';
import { formatRating, renderStars } from '@/lib/rating';

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/catalog');
}

const product = await getProductBySlug(slug);
if (!product) {
  return Astro.redirect('/catalog?error=Product+not+found');
}

const sessionUser = Astro.locals.user ?? null;
const [reviews, ratingSummary, userReview] = await Promise.all([
  getReviewsByProductId(product.id),
  getProductRatingSummary(product.id),
  sessionUser ? getUserReviewForProduct(sessionUser.id, product.id) : Promise.resolve(undefined),
]);

const error = Astro.url.searchParams.get('error');
const success = Astro.url.searchParams.get('success');
---

<BaseLayout title={`${product.name} — LunaLuxe`} description={product.description}>
  <Header />
  <CartDrawer client:load />

  <main class="mx-auto max-w-6xl px-6 pb-24 pt-28">
    <nav class="mb-6 text-sm text-luna-500">
      <a href="/catalog" class="hover:text-luna-800">Catalog</a>
      <span class="mx-2">/</span>
      <span class="text-luna-800">{product.name}</span>
    </nav>

    <Alert type="error" message={error} />
    <Alert type="success" message={success} />

    <section class="grid gap-10 lg:grid-cols-2">
      <div class="overflow-hidden rounded-2xl border border-luna-200 bg-luna-100">
        <img
          src={product.imageUrl}
          alt={product.name}
          class="aspect-square w-full object-cover"
        />
      </div>

      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-luna-500">{product.category}</p>
        <h1 class="mt-2 font-serif text-4xl font-semibold text-luna-900">{product.name}</h1>

        {ratingSummary.reviewCount > 0 && (
          <p class="mt-3 text-sm text-luna-600">
            <span class="text-lg text-lavender-500">{renderStars(ratingSummary.averageRating)}</span>
            <span class="ml-2 font-medium">{formatRating(ratingSummary.averageRating)}</span>
            <span class="text-luna-500"> ({ratingSummary.reviewCount} review{ratingSummary.reviewCount !== 1 ? 's' : ''})</span>
          </p>
        )}

        <p class="mt-4 text-2xl font-semibold text-luna-800">{formatCurrency(product.price)}</p>
        <p class="mt-6 leading-relaxed text-luna-600">{product.description}</p>

        <div class="mt-8">
          <AddToCartButton
            client:load
            productId={product.id}
            slug={product.slug}
            name={product.name}
            price={product.price}
            imageUrl={product.imageUrl}
          />
        </div>
      </div>
    </section>

    <section class="mt-16">
      <h2 class="font-serif text-3xl font-semibold text-luna-900">Customer reviews</h2>

      <div class="mt-8 grid gap-8 lg:grid-cols-2">
        <div>
          {sessionUser ? (
            <ReviewForm productSlug={product.slug} existingReview={userReview} />
          ) : (
            <div class="rounded-2xl border border-luna-200 bg-luna-50 p-6 text-center">
              <p class="text-sm text-luna-600">Sign in to leave a review.</p>
              <a
                href={`/login?redirect=${encodeURIComponent(`/products/${product.slug}`)}`}
                class="mt-4 inline-block rounded-full bg-luna-800 px-6 py-2.5 text-sm font-semibold text-luna-50 hover:bg-luna-700"
              >
                Log in
              </a>
            </div>
          )}
        </div>

        <div>
          <ReviewList reviews={reviews} />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
