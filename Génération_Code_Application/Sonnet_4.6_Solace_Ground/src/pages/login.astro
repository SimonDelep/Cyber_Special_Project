---
import AuthLayout from '@/layouts/AuthLayout.astro';
import AuthForm from '@/components/solid/AuthForm';

const user = Astro.locals.user;
if (user) {
  return Astro.redirect('/profile');
}

const next = Astro.url.searchParams.get('next') ?? '/profile';
---

<AuthLayout title="Sign in — Solace Ground">
  <h1 class="font-serif text-3xl text-cork-900">Welcome back</h1>
  <p class="mt-2 text-sm text-cork-600">Sign in with your username and password.</p>
  <div class="mt-8">
    <AuthForm client:load mode="login" redirectTo={next} />
  </div>
  <p class="mt-6 text-center text-sm text-cork-600">
    No account?
    <a href="/register" class="font-medium text-cork-800 underline-offset-2 hover:underline">
      Create one
    </a>
  </p>
</AuthLayout>
