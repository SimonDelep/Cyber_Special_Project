---
import AddToCartButton from '@/components/solid/AddToCartButton';
import type { Product } from '@/db/schema';
import { formatPrice } from '@/lib/utils';

interface Props {
  product: Product;
  reviewCount?: number;
  averageRating?: number | null;
}

const { product, reviewCount = 0, averageRating = null } = Astro.props;

const categoryLabel =
  product.category === 'yoga-mat' ? 'Yoga mat' : 'Meditation cushion';

const accentClass =
  product.category === 'yoga-mat'
    ? 'from-cork-100 via-cork-200 to-sage-400/20'
    : 'from-cork-50 via-sage-400/15 to-cork-200';
---

<article class="group flex h-full flex-col overflow-hidden rounded-2xl border border-cork-200 bg-white shadow-sm transition-shadow hover:shadow-md">
  <a href={`/products/${product.slug}`} class="block">
    <div class:list={['relative aspect-[4/3] overflow-hidden bg-gradient-to-br', accentClass]}>
      {
        product.imageUrl ? (
          <img
            src={product.imageUrl}
            alt=""
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
        ) : (
          <div class="flex h-full flex-col items-center justify-center gap-2 p-6 text-center">
            <span class="font-serif text-3xl text-cork-500/70">
              {product.category === 'yoga-mat' ? '◯' : '◇'}
            </span>
            <span class="text-xs uppercase tracking-widest text-cork-500">{categoryLabel}</span>
          </div>
        )
      }
      {
        !product.inStock && (
          <span class="absolute right-3 top-3 rounded-full bg-cork-800/90 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wide text-cork-50">
            Out of stock
          </span>
        )
      }
    </div>
  </a>

  <div class="flex flex-1 flex-col p-6">
    <p class="text-xs font-medium uppercase tracking-wider text-sage-600">{categoryLabel}</p>
    <h3 class="mt-1 font-serif text-xl text-cork-900">
      <a href={`/products/${product.slug}`} class="hover:text-cork-700">
        {product.name}
      </a>
    </h3>
    {
      averageRating !== null && reviewCount > 0 && (
        <p class="mt-1 text-sm text-cork-600">
          ★ {averageRating} · {reviewCount} review{reviewCount === 1 ? '' : 's'}
        </p>
      )
    }
    <p class="mt-2 flex-1 text-sm leading-relaxed text-cork-600 line-clamp-3">
      {product.description}
    </p>
    <div class="mt-5 flex items-center justify-between gap-4 border-t border-cork-100 pt-4">
      <p class="text-lg font-semibold text-cork-900">{formatPrice(product.priceCents)}</p>
      {
        product.inStock ? (
          <AddToCartButton
            client:visible
            productId={product.id}
            name={product.name}
            priceCents={product.priceCents}
          />
        ) : (
          <span class="text-xs font-medium text-cork-500">Unavailable</span>
        )
      }
    </div>
  </div>
</article>
