---
import type { PublicUser } from '@/types/auth';

interface Props {
  user: PublicUser | null;
}

const { user } = Astro.props;
---

<div class="flex items-center gap-3">
  {
    user ? (
      <>
        {user.role === 'admin' && (
          <a
            href="/admin"
            class="hidden text-sm font-medium text-sage-600 hover:text-sage-700 sm:inline"
          >
            Admin
          </a>
        )}
        <a href="/profile" class="flex items-center gap-2 text-sm font-medium text-cork-700 hover:text-cork-900">
          {user.avatarUrl ? (
            <img
              src={user.avatarUrl}
              alt=""
              class="h-8 w-8 rounded-full border border-cork-300 object-cover"
            />
          ) : (
            <span class="flex h-8 w-8 items-center justify-center rounded-full border border-cork-300 bg-cork-200 text-xs font-semibold text-cork-700">
              {user.username.slice(0, 1).toUpperCase()}
            </span>
          )}
          <span class="hidden sm:inline">{user.displayName ?? user.username}</span>
        </a>
      </>
    ) : (
      <>
        <a href="/login" class="text-sm font-medium text-cork-700 hover:text-cork-900">
          Sign in
        </a>
        <a
          href="/register"
          class="rounded-full border border-cork-400 px-4 py-1.5 text-sm font-medium text-cork-800 hover:bg-cork-100"
        >
          Register
        </a>
      </>
    )
  }
</div>
