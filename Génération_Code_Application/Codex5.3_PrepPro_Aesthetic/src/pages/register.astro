---
import AppLayout from "@/layouts/AppLayout.astro";
import AuthForm from "@/components/auth/AuthForm";
---

<AppLayout title="Register — PrepPro Aesthetic">
  <main class="px-4 py-16 sm:px-6">
    <AuthForm mode="register" next="/profile" client:load />
    <p class="mx-auto mt-6 max-w-md text-center text-sm text-muted">
      <a href="/login" class="font-medium text-brand-700 hover:underline">
        Already have an account? Sign in
      </a>
    </p>
  </main>
</AppLayout>
