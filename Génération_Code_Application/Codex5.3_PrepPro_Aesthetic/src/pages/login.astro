---
import AppLayout from "@/layouts/AppLayout.astro";
import AuthForm from "@/components/auth/AuthForm";

const next = Astro.url.searchParams.get("next") ?? "/profile";
---

<AppLayout title="Sign in — PrepPro Aesthetic">
  <main class="px-4 py-16 sm:px-6">
    <AuthForm mode="login" next={next} client:load />
    <p class="mx-auto mt-6 max-w-md text-center text-sm text-muted">
      <a href="/register" class="font-medium text-brand-700 hover:underline">
        Create an account
      </a>
    </p>
  </main>
</AppLayout>
