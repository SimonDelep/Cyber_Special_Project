# Configuration eBoutique

## Server Configuration
PORT=3000
HOST=localhost

## Database
DATABASE_PATH=./boutique.db

## JWT Configuration
JWT_SECRET=your_super_secret_key_change_in_production_12345
JWT_EXPIRES_IN=7d

## Admin Credentials
ADMIN_EMAIL=admin@boutique.com
ADMIN_PASSWORD=admin123

## Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

## Email Configuration (optionnel)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_password
# SMTP_FROM=noreply@eboutique.com

## Payment Configuration (Stripe, PayPal)
# STRIPE_PUBLIC_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# PAYPAL_CLIENT_ID=...

## Environment
NODE_ENV=development

## Logging
LOG_LEVEL=info
