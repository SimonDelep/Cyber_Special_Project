---
import type { PokemonCard } from '@/lib/pokemon';
import { formatHeight, formatWeight } from '@/lib/pokemon';

interface Props {
  pokemon: PokemonCard[];
  error?: string | null;
}

const { pokemon, error = null } = Astro.props;

const typeStyles: Record<string, string> = {
  normal: 'bg-slate-500/30 text-slate-200',
  fire: 'bg-orange-600/30 text-orange-200',
  water: 'bg-blue-600/30 text-blue-200',
  electric: 'bg-yellow-500/30 text-yellow-100',
  grass: 'bg-emerald-600/30 text-emerald-200',
  ice: 'bg-cyan-400/30 text-cyan-100',
  fighting: 'bg-red-700/30 text-red-200',
  poison: 'bg-purple-600/30 text-purple-200',
  ground: 'bg-amber-700/30 text-amber-200',
  flying: 'bg-indigo-400/30 text-indigo-100',
  psychic: 'bg-pink-600/30 text-pink-200',
  bug: 'bg-lime-600/30 text-lime-200',
  rock: 'bg-stone-600/30 text-stone-200',
  ghost: 'bg-violet-700/30 text-violet-200',
  dragon: 'bg-indigo-700/30 text-indigo-200',
  dark: 'bg-neutral-700/30 text-neutral-200',
  steel: 'bg-slate-400/30 text-slate-100',
  fairy: 'bg-rose-400/30 text-rose-100',
};
---

<section id="pokemon" class="border-t border-white/10 bg-gradient-to-b from-slate-950 via-slate-900/40 to-slate-950">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <div class="mb-10 max-w-2xl">
      <p class="text-xs font-medium uppercase tracking-wider text-stream-400">Live from PokéAPI</p>
      <h2 class="mt-1 text-2xl font-bold text-white sm:text-3xl">Pokémon showcase</h2>
      <p class="mt-3 text-slate-400">
        Real-time species data from
        <a
          href="https://pokeapi.co/"
          class="text-volt-400 underline-offset-2 hover:text-volt-300 hover:underline"
          target="_blank"
          rel="noopener noreferrer"
        >pokeapi.co</a>
        — sprites, types, height, and weight.
      </p>
    </div>

    {error ? (
      <div class="rounded-2xl border border-amber-500/30 bg-amber-950/30 p-6 text-amber-100">
        <p class="font-medium">Could not load Pokémon</p>
        <p class="mt-2 text-sm text-amber-200/80">{error}</p>
      </div>
    ) : pokemon.length === 0 ? (
      <p class="text-slate-400">No Pokémon data available right now.</p>
    ) : (
      <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {
          pokemon.map((mon) => (
            <li class="group overflow-hidden rounded-2xl border border-white/10 bg-slate-900/60 shadow-lg shadow-black/20 transition hover:border-stream-500/40">
              <div class="relative flex aspect-square items-center justify-center bg-gradient-to-br from-slate-800/80 to-slate-950 p-6">
                <span class="absolute left-3 top-3 rounded-full bg-slate-950/80 px-2 py-0.5 font-mono text-xs text-slate-400">
                  #{String(mon.id).padStart(3, '0')}
                </span>
                <img
                  src={mon.image}
                  alt={mon.displayName}
                  class="h-32 w-32 object-contain drop-shadow-lg transition duration-300 group-hover:scale-110"
                  loading="lazy"
                  width="128"
                  height="128"
                />
              </div>
              <div class="space-y-3 p-4">
                <h3 class="text-lg font-semibold text-white">{mon.displayName}</h3>
                <div class="flex flex-wrap gap-1.5">
                  {mon.types.map((type) => (
                    <span
                      class:list={[
                        'rounded-full px-2.5 py-0.5 text-xs font-medium capitalize',
                        typeStyles[type] ?? 'bg-slate-600/30 text-slate-200',
                      ]}
                    >
                      {type}
                    </span>
                  ))}
                </div>
                <dl class="grid grid-cols-2 gap-2 text-xs text-slate-400">
                  <div>
                    <dt class="uppercase tracking-wider text-slate-500">Height</dt>
                    <dd class="font-medium text-slate-200">{formatHeight(mon.heightDm)}</dd>
                  </div>
                  <div>
                    <dt class="uppercase tracking-wider text-slate-500">Weight</dt>
                    <dd class="font-medium text-slate-200">{formatWeight(mon.weightHg)}</dd>
                  </div>
                </dl>
              </div>
            </li>
          ))
        }
      </ul>
    )}
  </div>
</section>
