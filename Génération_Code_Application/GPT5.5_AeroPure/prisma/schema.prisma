generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ProductCategory {
  WIRELESS_CHARGING
  SOLAR_POWER_BANK
  TRAVEL_ORGANIZER
}

enum LogLevel {
  INFO
  WARN
  ERROR
  SUCCESS
}

enum LogCategory {
  AUTH
  PROFILE
  TRANSACTION
  CART
  ADMIN
  REVIEW
  SYSTEM
}

model User {
  id             String    @id @default(cuid())
  username       String    @unique
  email          String    @unique
  passwordHash   String
  role           Role      @default(USER)
  balance        Decimal   @default(0) @db.Decimal(10, 2)
  firstName      String?
  lastName       String?
  bio            String?
  profilePicture String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  sessions       Session[]
  reviews        Review[]
  orders         Order[]

  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Product {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  description String
  price       Decimal         @db.Decimal(10, 2)
  imageUrl    String?
  category    ProductCategory
  featured    Boolean         @default(false)
  inStock     Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  reviews     Review[]

  @@index([category])
  @@index([featured])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  title     String?
  content   String
  imageUrl  String?
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId])
  @@index([userId])
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  total       Decimal     @db.Decimal(10, 2)
  status      String      @default("COMPLETED")
  createdAt   DateTime    @default(now())
  items       OrderItem[]

  @@index([userId])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  productName String
  productSlug String?
  unitPrice   Decimal  @db.Decimal(10, 2)
  quantity    Int
  lineTotal   Decimal  @db.Decimal(10, 2)

  @@index([orderId])
}

model SystemLog {
  id        String      @id @default(cuid())
  level     LogLevel    @default(INFO)
  category  LogCategory
  action    String
  message   String
  userId    String?
  username  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  @@index([category])
  @@index([level])
  @@index([userId])
  @@index([createdAt])
}
