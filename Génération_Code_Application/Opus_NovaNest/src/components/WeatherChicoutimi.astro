---
import type { ChicoutimiWeather } from '../lib/weather/chicoutimi';
import { formatObservedTime } from '../lib/weather/chicoutimi';

interface Props {
  weather: ChicoutimiWeather | null;
}

const { weather } = Astro.props;
const updatedLabel = weather ? formatObservedTime(weather.observedAt) : '';
---

<aside
  class="w-full max-w-sm rounded-2xl border border-white/10 bg-nest-900/70 p-5 shadow-lg shadow-black/20 backdrop-blur-md sm:max-w-xs"
  aria-label="Current weather in Chicoutimi"
>
  {weather ? (
    <>
      <div class="flex items-start justify-between gap-3">
        <div>
          <p class="text-xs font-medium uppercase tracking-wide text-accent">Local weather</p>
          <p class="mt-0.5 font-display text-lg font-semibold text-white">{weather.location}</p>
        </div>
        <span class="text-4xl" aria-hidden="true">{weather.icon}</span>
      </div>

      <p class="mt-4 font-display text-4xl font-bold tabular-nums text-white">
        {weather.temperatureC}°<span class="text-2xl text-nest-100/60">C</span>
      </p>
      <p class="mt-1 text-sm text-nest-100/80">{weather.condition}</p>

      <dl class="mt-4 grid grid-cols-2 gap-3 border-t border-white/10 pt-4 text-sm">
        <div>
          <dt class="text-nest-100/50">Feels like</dt>
          <dd class="font-medium text-white">{weather.apparentTemperatureC}°C</dd>
        </div>
        <div>
          <dt class="text-nest-100/50">Humidity</dt>
          <dd class="font-medium text-white">{weather.humidityPercent}%</dd>
        </div>
        <div>
          <dt class="text-nest-100/50">Wind</dt>
          <dd class="font-medium text-white">{weather.windSpeedKmh} km/h</dd>
        </div>
        {updatedLabel && (
          <div>
            <dt class="text-nest-100/50">Updated</dt>
            <dd class="font-medium text-white">{updatedLabel}</dd>
          </div>
        )}
      </dl>
    </>
  ) : (
    <p class="text-sm text-nest-100/60">
      Weather for Chicoutimi is temporarily unavailable.
    </p>
  )}
</aside>
