---
import CartButton from '../solid/CartButton';
import type { SafeUser } from '../../lib/db/schema';
import { ROLES } from '../../lib/auth/constants';

interface Props {
  user: SafeUser | null;
}

const { user } = Astro.props;
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-nest-950/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2 font-display text-xl font-semibold tracking-tight text-white">
      <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-accent to-glow text-sm font-bold text-nest-950">
        N
      </span>
      NovaNest
    </a>

    <nav class="hidden items-center gap-8 text-sm text-nest-100/80 md:flex" aria-label="Main">
      <a href="/catalog" class="transition hover:text-accent">Catalog</a>
      <a href="/cart" class="transition hover:text-accent">Cart</a>
      <a href="/#categories" class="transition hover:text-accent">Categories</a>
      <a href="/#features" class="transition hover:text-accent">Why NovaNest</a>
      {user && <a href="/profile" class="transition hover:text-accent">Profile</a>}
      {user?.role === ROLES.ADMIN && (
        <a href="/admin" class="transition hover:text-accent">Admin</a>
      )}
    </nav>

    <div class="flex items-center gap-3 sm:gap-4">
      {user ? (
        <div class="hidden items-center gap-3 sm:flex">
          {user.avatarUrl ? (
            <img
              src={user.avatarUrl}
              alt=""
              class="h-8 w-8 rounded-full object-cover ring-1 ring-white/20"
              width="32"
              height="32"
            />
          ) : (
            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-nest-800 text-xs font-medium text-accent ring-1 ring-white/20">
              {user.displayName.charAt(0).toUpperCase()}
            </span>
          )}
          <span class="max-w-[8rem] truncate text-sm text-nest-100/80">{user.displayName}</span>
        </div>
      ) : (
        <>
          <a
            href="/login"
            class="hidden text-sm text-nest-100/80 transition hover:text-accent sm:inline"
          >
            Log in
          </a>
          <a
            href="/register"
            class="hidden rounded-full border border-white/20 px-4 py-2 text-sm font-medium text-white transition hover:border-accent/50 sm:inline-block"
          >
            Sign up
          </a>
        </>
      )}
      <a
        href="/catalog"
        class="hidden rounded-full bg-accent px-4 py-2 text-sm font-medium text-nest-950 transition hover:bg-accent/90 lg:inline-block"
      >
        Shop now
      </a>
      <CartButton client:load />
    </div>
  </div>
</header>
