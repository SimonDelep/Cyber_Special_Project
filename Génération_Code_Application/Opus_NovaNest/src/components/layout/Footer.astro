---
const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-nest-900/50">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="font-display text-lg font-semibold text-white">NovaNest</p>
        <p class="mt-2 max-w-xs text-sm text-nest-100/60">
          Sleek smart home tech — doorbell cameras and ambient lighting, all from one app.
        </p>
      </div>
      <div class="flex gap-12 text-sm text-nest-100/70">
        <div>
          <p class="mb-3 font-medium text-white">Shop</p>
          <ul class="space-y-2">
            <li><a href="/catalog" class="hover:text-accent">All products</a></li>
            <li><a href="/catalog?category=doorbell-cameras" class="hover:text-accent">Doorbell cameras</a></li>
            <li><a href="/catalog?category=smart-lighting" class="hover:text-accent">Smart lighting</a></li>
          </ul>
        </div>
        <div>
          <p class="mb-3 font-medium text-white">Support</p>
          <ul class="space-y-2">
            <li><a href="#" class="hover:text-accent">Setup guides</a></li>
            <li><a href="#" class="hover:text-accent">Contact</a></li>
          </ul>
        </div>
      </div>
    </div>
    <p class="mt-10 border-t border-white/10 pt-6 text-center text-xs text-nest-100/50 sm:text-left">
      &copy; {year} NovaNest. All rights reserved.
    </p>
  </div>
</footer>
