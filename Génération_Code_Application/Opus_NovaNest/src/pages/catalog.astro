---
import BaseLayout from '../layouts/BaseLayout.astro';
import CatalogBrowser from '../components/solid/CatalogBrowser';
---

<BaseLayout
  title="Product catalog — NovaNest"
  description="Browse and filter NovaNest smart home products."
>
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="mb-10">
      <p class="text-sm font-medium text-accent">Catalog</p>
      <h1 class="font-display text-3xl font-bold text-white sm:text-4xl">All products</h1>
      <p class="mt-2 max-w-2xl text-nest-100/60">
        Search and filter doorbell cameras and smart lighting. Open a product to read reviews or
        add it to your cart.
      </p>
    </div>
    <CatalogBrowser client:load />
  </section>
</BaseLayout>
