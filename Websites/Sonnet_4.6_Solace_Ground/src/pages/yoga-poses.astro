---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import YogaPoseExplorer from '@/components/solid/YogaPoseExplorer';

const user = Astro.locals.user;
---

<BaseLayout title="Yoga poses — Solace Ground">
  <Header user={user} />
  <main class="flex-1">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <p class="text-xs font-medium uppercase tracking-wider text-sage-600">External pose library</p>
      <h1 class="mt-2 font-serif text-3xl text-cork-900 md:text-4xl">Yoga pose explorer</h1>
      <p class="mt-2 max-w-2xl text-cork-600">
        Discover asanas with illustrations and descriptions from the community-maintained{' '}
        <a
          href="https://github.com/alexcumplido/yoga-api"
          class="font-medium text-cork-800 underline"
          target="_blank"
          rel="noopener noreferrer"
        >
          Yoga API
        </a>
        . Filter by difficulty or search by name.
      </p>
      <div class="mt-10">
        <YogaPoseExplorer client:load />
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
