---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CartPage from '@/components/solid/CartPage';

const user = Astro.locals.user;
const loginNext = '/cart';
---

<BaseLayout title="Cart — Solace Ground">
  <Header user={user} />
  <main class="flex-1">
    <div class="mx-auto max-w-3xl px-6 py-16">
      <h1 class="font-serif text-3xl text-cork-900">Your cart</h1>
      <p class="mt-2 text-cork-600">
        Review your items and complete checkout using your account balance.
      </p>
      <div class="mt-10">
        <CartPage client:load user={user} loginNext={loginNext} />
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
