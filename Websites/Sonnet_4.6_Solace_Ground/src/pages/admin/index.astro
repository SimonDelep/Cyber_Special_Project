---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import AdminPanel from '@/components/solid/AdminPanel';
import { isAdmin } from '@/lib/auth/rbac';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login?next=/admin');
}
if (!isAdmin(user)) {
  return Astro.redirect('/profile');
}
---

<BaseLayout title="Admin — Solace Ground">
  <Header user={user} />
  <main class="flex-1">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <p class="text-xs font-medium uppercase tracking-wider text-sage-600">Administrator</p>
      <h1 class="mt-2 font-serif text-3xl text-cork-900">Admin panel</h1>
      <p class="mt-2 text-cork-600">
        Manage users, account balances, product catalog, and review the internal system event log.
      </p>
      <div class="mt-10">
        <AdminPanel client:load currentAdminId={user.id} />
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
