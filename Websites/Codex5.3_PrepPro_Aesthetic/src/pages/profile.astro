---
import AppLayout from "@/layouts/AppLayout.astro";
import ProfileForm from "@/components/auth/ProfileForm";

const user = Astro.locals.user!;
const forbidden = Astro.url.searchParams.get("error") === "forbidden";
---

<AppLayout title="My profile — PrepPro Aesthetic">
  <main class="px-4 py-12 sm:px-6">
    <ProfileForm user={user} forbidden={forbidden} client:load />
  </main>
</AppLayout>
