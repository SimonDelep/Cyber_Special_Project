# PostgreSQL (docker-compose defaults)
POSTGRES_USER=zestzing
POSTGRES_PASSWORD=zestzing_secret
POSTGRES_DB=zestzing
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# Backend (5434 avoids conflict if another Postgres uses 5432)
DATABASE_URL=postgresql://zestzing:zestzing_secret@localhost:5434/zestzing
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Frontend (Vite)
VITE_API_URL=http://localhost:8000

SECRET_KEY=change-me-in-production-use-a-long-random-string
SESSION_COOKIE_NAME=zestzing_session
SESSION_EXPIRE_DAYS=7

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@zestzing.com
ADMIN_PASSWORD=admin123
