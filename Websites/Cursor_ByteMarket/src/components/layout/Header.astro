---
import CartButton from "@/components/solid/CartButton";
import { getCurrentUser } from "@/lib/auth";

const authUser = getCurrentUser(Astro.cookies);
---

<header class="sticky top-0 z-50 border-b border-border/80 bg-surface/90 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-4 sm:px-6">
    <a href="/" class="group flex items-center gap-2 font-semibold tracking-tight">
      <span
        class="flex h-9 w-9 items-center justify-center rounded-lg bg-accent/15 font-mono text-sm text-accent ring-1 ring-accent/30 transition group-hover:bg-accent/25"
        aria-hidden="true"
      >
        BM
      </span>
      <span class="text-lg">Byte<span class="text-accent">Market</span></span>
    </a>

    <nav class="hidden items-center gap-8 text-sm text-ink-muted md:flex" aria-label="Main">
      <a href="/#categories" class="transition hover:text-ink">Categories</a>
      <a href="/catalog" class="transition hover:text-ink">Catalog</a>
      <a href="/#products" class="transition hover:text-ink">Products</a>
      <a href="/cart" class="transition hover:text-ink">Cart</a>
      <a href="/#about" class="transition hover:text-ink">About</a>
      {
        authUser && (
          <a href="/profile" class="transition hover:text-ink">
            Profile
          </a>
        )
      }
      {
        authUser?.role === "admin" && (
          <a href="/admin" class="transition hover:text-ink">
            Admin
          </a>
        )
      }
    </nav>

    <div class="flex items-center gap-3">
      {
        authUser ? (
          <>
            <span class="hidden text-sm text-ink-muted sm:inline">
              @{authUser.username}
            </span>
            <form method="post" action="/api/auth/logout">
              <button
                type="submit"
                class="rounded-lg border border-border px-3 py-2 text-sm text-ink-muted transition hover:border-ink-muted/50 hover:text-ink"
              >
                Sign out
              </button>
            </form>
          </>
        ) : (
          <>
            <a
              href="/login"
              class="hidden rounded-lg border border-border px-4 py-2 text-sm font-medium text-ink transition hover:border-ink-muted/50 sm:inline-flex"
            >
              Sign in
            </a>
            <a
              href="/register"
              class="hidden rounded-lg bg-accent px-4 py-2 text-sm font-medium text-surface transition hover:bg-accent-dim sm:inline-flex"
            >
              Register
            </a>
          </>
        )
      }
      <a
        href="/catalog"
        class="hidden rounded-lg bg-accent px-4 py-2 text-sm font-medium text-surface transition hover:bg-accent-dim lg:inline-flex"
      >
        Shop now
      </a>
      <CartButton client:load />
    </div>
  </div>
</header>
