---
import { formatPrice, type CatalogProduct } from "@/lib/products";

interface Props {
  products: CatalogProduct[];
}

const { products } = Astro.props;
---

<section id="products" class="py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">Our products</h2>
        <p class="mt-2 text-ink-muted">
          {products.length > 0
            ? `${products.length} featured items — search and filter the full catalog.`
            : "Browse our electronics catalog."}
        </p>
      </div>
      <a
        href="/catalog"
        class="shrink-0 rounded-lg border border-accent/40 bg-accent/10 px-4 py-2 text-sm font-medium text-accent transition hover:bg-accent/20"
      >
        Full catalog →
      </a>
    </div>

    {
      products.length === 0 ? (
        <p class="mt-10 rounded-xl border border-dashed border-border p-8 text-center text-ink-muted">
          No products yet. Run{" "}
          <code class="rounded bg-surface-muted px-1.5 py-0.5 font-mono text-sm text-accent">
            npm run db:setup
          </code>{" "}
          to seed the database.
        </p>
      ) : (
        <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {products.map((product) => (
            <li>
              <article class="flex h-full flex-col overflow-hidden rounded-xl border border-border bg-surface-raised transition hover:border-accent/30">
                <a
                  href={`/catalog/${product.slug}`}
                  class="relative block aspect-[4/3] overflow-hidden bg-surface-muted/50"
                >
                  {product.imageUrl ? (
                    <img
                      src={product.imageUrl}
                      alt={product.name}
                      class="h-full w-full object-cover"
                      loading="lazy"
                      width="400"
                      height="300"
                    />
                  ) : (
                    <div class="flex h-full items-center justify-center font-mono text-4xl text-ink-muted/40">
                      {product.categorySlug?.slice(0, 2).toUpperCase() ?? "BM"}
                    </div>
                  )}
                  {product.stock === 0 && (
                    <span class="absolute right-3 top-3 rounded-full bg-surface/90 px-2.5 py-1 text-xs font-medium text-ink-muted ring-1 ring-border">
                      Out of stock
                    </span>
                  )}
                </a>
                <div class="flex flex-1 flex-col p-5">
                  {product.categoryName && (
                    <p class="text-xs font-medium uppercase tracking-wide text-accent">
                      {product.categoryName}
                    </p>
                  )}
                  <h3 class="mt-1 font-semibold leading-snug">
                    <a href={`/catalog/${product.slug}`} class="hover:text-accent">
                      {product.name}
                    </a>
                  </h3>
                  <p class="mt-2 flex-1 text-sm text-ink-muted line-clamp-2">
                    {product.description}
                  </p>
                  <div class="mt-4 flex items-baseline justify-between gap-2">
                    <p class="text-lg font-semibold text-ink">
                      {formatPrice(product.priceCents)}
                    </p>
                    {product.stock > 0 && (
                      <p class="text-xs text-ink-muted">{product.stock} in stock</p>
                    )}
                  </div>
                  <div class="mt-4 flex gap-2">
                    <a
                      href={`/catalog/${product.slug}`}
                      class="flex-1 rounded-lg border border-border px-4 py-2 text-center text-sm font-medium text-ink transition hover:border-ink-muted/50"
                    >
                      Details
                    </a>
                    {product.stock > 0 ? (
                      <button
                        type="button"
                        data-add-to-cart
                        data-product-id={product.id}
                        data-product-slug={product.slug}
                        data-product-name={product.name}
                        data-product-price={product.priceCents}
                        class="flex-1 rounded-lg border border-accent/40 bg-accent/10 px-4 py-2 text-sm font-medium text-accent transition hover:bg-accent/20"
                      >
                        Add to cart
                      </button>
                    ) : (
                      <button
                        type="button"
                        disabled
                        class="flex-1 cursor-not-allowed rounded-lg border border-border px-4 py-2 text-sm text-ink-muted"
                      >
                        Out of stock
                      </button>
                    )}
                  </div>
                </div>
              </article>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>
