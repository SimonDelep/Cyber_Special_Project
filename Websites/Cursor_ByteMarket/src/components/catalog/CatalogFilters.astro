---
import type { Category } from "@/db/schema";
import type { CatalogSort } from "@/lib/products";

interface Props {
  categories: Category[];
  q: string;
  category: string;
  minPrice: string;
  maxPrice: string;
  inStockOnly: boolean;
  sort: CatalogSort;
}

const { categories, q, category, minPrice, maxPrice, inStockOnly, sort } =
  Astro.props;

const sortOptions: { value: CatalogSort; label: string }[] = [
  { value: "name_asc", label: "Name (A–Z)" },
  { value: "name_desc", label: "Name (Z–A)" },
  { value: "price_asc", label: "Price (low to high)" },
  { value: "price_desc", label: "Price (high to low)" },
];
---

<form
  method="get"
  action="/catalog"
  class="rounded-xl border border-border bg-surface-raised p-5 sm:p-6"
>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <div class="sm:col-span-2 lg:col-span-3">
      <label for="catalog-q" class="block text-sm font-medium text-ink">
        Search
      </label>
      <input
        id="catalog-q"
        type="search"
        name="q"
        value={q}
        placeholder="Product name, description…"
        class="mt-1.5 w-full rounded-lg border border-border bg-surface px-3 py-2 text-sm text-ink placeholder:text-ink-muted/60 focus:border-accent/50 focus:outline-none focus:ring-1 focus:ring-accent/30"
      />
    </div>

    <div>
      <label for="catalog-category" class="block text-sm font-medium text-ink">
        Category
      </label>
      <select
        id="catalog-category"
        name="category"
        class="mt-1.5 w-full rounded-lg border border-border bg-surface px-3 py-2 text-sm text-ink focus:border-accent/50 focus:outline-none focus:ring-1 focus:ring-accent/30"
      >
        <option value="">All categories</option>
        {
          categories.map((cat) => (
            <option value={cat.slug} selected={category === cat.slug}>
              {cat.name}
            </option>
          ))
        }
      </select>
    </div>

    <div>
      <label for="catalog-sort" class="block text-sm font-medium text-ink">
        Sort by
      </label>
      <select
        id="catalog-sort"
        name="sort"
        class="mt-1.5 w-full rounded-lg border border-border bg-surface px-3 py-2 text-sm text-ink focus:border-accent/50 focus:outline-none focus:ring-1 focus:ring-accent/30"
      >
        {
          sortOptions.map((opt) => (
            <option value={opt.value} selected={sort === opt.value}>
              {opt.label}
            </option>
          ))
        }
      </select>
    </div>

    <div>
      <label for="catalog-min-price" class="block text-sm font-medium text-ink">
        Min price (CAD)
      </label>
      <input
        id="catalog-min-price"
        type="number"
        name="minPrice"
        min="0"
        step="0.01"
        value={minPrice}
        placeholder="0"
        class="mt-1.5 w-full rounded-lg border border-border bg-surface px-3 py-2 text-sm text-ink placeholder:text-ink-muted/60 focus:border-accent/50 focus:outline-none focus:ring-1 focus:ring-accent/30"
      />
    </div>

    <div>
      <label for="catalog-max-price" class="block text-sm font-medium text-ink">
        Max price (CAD)
      </label>
      <input
        id="catalog-max-price"
        type="number"
        name="maxPrice"
        min="0"
        step="0.01"
        value={maxPrice}
        placeholder="Any"
        class="mt-1.5 w-full rounded-lg border border-border bg-surface px-3 py-2 text-sm text-ink placeholder:text-ink-muted/60 focus:border-accent/50 focus:outline-none focus:ring-1 focus:ring-accent/30"
      />
    </div>

    <div class="flex items-end">
      <label class="flex cursor-pointer items-center gap-2 text-sm text-ink">
        <input
          type="checkbox"
          name="inStock"
          value="1"
          checked={inStockOnly}
          class="h-4 w-4 rounded border-border bg-surface text-accent focus:ring-accent/30"
        />
        In stock only
      </label>
    </div>
  </div>

  <div class="mt-5 flex flex-wrap gap-3">
    <button
      type="submit"
      class="rounded-lg bg-accent px-5 py-2 text-sm font-semibold text-surface transition hover:bg-accent-dim"
    >
      Apply filters
    </button>
    <a
      href="/catalog"
      class="rounded-lg border border-border px-5 py-2 text-sm font-medium text-ink-muted transition hover:border-ink-muted/50 hover:text-ink"
    >
      Reset
    </a>
  </div>
</form>
