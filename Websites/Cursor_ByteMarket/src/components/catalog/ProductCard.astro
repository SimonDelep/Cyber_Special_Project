---
import { formatPrice, type CatalogProduct } from "@/lib/products";

interface Props {
  product: CatalogProduct;
}

const { product } = Astro.props;
---

<li>
  <article class="flex h-full flex-col overflow-hidden rounded-xl border border-border bg-surface-raised transition hover:border-accent/30">
    <a
      href={`/catalog/${product.slug}`}
      class="relative block aspect-[4/3] overflow-hidden bg-surface-muted/50"
    >
      {
        product.imageUrl ? (
          <img
            src={product.imageUrl}
            alt={product.name}
            class="h-full w-full object-cover transition group-hover:scale-[1.02]"
            loading="lazy"
            width="400"
            height="300"
          />
        ) : (
          <div class="flex h-full items-center justify-center font-mono text-4xl text-ink-muted/40">
            {product.categorySlug?.slice(0, 2).toUpperCase() ?? "BM"}
          </div>
        )
      }
      {
        product.stock === 0 && (
          <span class="absolute right-3 top-3 rounded-full bg-surface/90 px-2.5 py-1 text-xs font-medium text-ink-muted ring-1 ring-border">
            Out of stock
          </span>
        )
      }
    </a>
    <div class="flex flex-1 flex-col p-5">
      {
        product.categoryName && (
          <p class="text-xs font-medium uppercase tracking-wide text-accent">
            {product.categoryName}
          </p>
        )
      }
      <h3 class="mt-1 font-semibold leading-snug">
        <a href={`/catalog/${product.slug}`} class="hover:text-accent">
          {product.name}
        </a>
      </h3>
      <p class="mt-2 flex-1 text-sm text-ink-muted line-clamp-2">
        {product.description}
      </p>
      <div class="mt-4 flex items-baseline justify-between gap-2">
        <p class="text-lg font-semibold text-ink">
          {formatPrice(product.priceCents)}
        </p>
        {
          product.stock > 0 && (
            <p class="text-xs text-ink-muted">{product.stock} in stock</p>
          )
        }
      </div>
      <div class="mt-4 flex gap-2">
        <a
          href={`/catalog/${product.slug}`}
          class="flex-1 rounded-lg border border-border px-4 py-2 text-center text-sm font-medium text-ink transition hover:border-ink-muted/50"
        >
          Details
        </a>
        {
          product.stock > 0 ? (
            <button
              type="button"
              data-add-to-cart
              data-product-id={product.id}
              data-product-slug={product.slug}
              data-product-name={product.name}
              data-product-price={product.priceCents}
              class="flex-1 rounded-lg border border-accent/40 bg-accent/10 px-4 py-2 text-sm font-medium text-accent transition hover:bg-accent/20"
            >
              Add to cart
            </button>
          ) : (
            <button
              type="button"
              disabled
              class="flex-1 cursor-not-allowed rounded-lg border border-border px-4 py-2 text-sm text-ink-muted"
            >
              Out of stock
            </button>
          )
        }
      </div>
    </div>
  </article>
</li>
