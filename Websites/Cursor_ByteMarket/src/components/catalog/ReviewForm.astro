---
interface Props {
  productSlug: string;
}

const { productSlug } = Astro.props;
---

<form
  method="post"
  action={`/api/products/${productSlug}/reviews`}
  enctype="multipart/form-data"
  class="rounded-xl border border-border bg-surface-raised p-5 sm:p-6"
>
  <h3 class="text-lg font-semibold text-ink">Write a review</h3>
  <p class="mt-1 text-sm text-ink-muted">
    One review per product. Optional photo via URL or file upload (max 3 MB).
  </p>

  <fieldset class="mt-5">
    <legend class="text-sm font-medium text-ink">Rating</legend>
    <div class="mt-2 flex flex-wrap gap-3">
      {
        [1, 2, 3, 4, 5].map((value) => (
          <label class="flex cursor-pointer items-center gap-1.5 rounded-lg border border-border px-3 py-2 text-sm transition has-[:checked]:border-accent/50 has-[:checked]:bg-accent/10">
            <input
              type="radio"
              name="rating"
              value={value}
              required
              class="text-accent focus:ring-accent/30"
            />
            <span>{value} ★</span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <div class="mt-4">
    <label for="review-title" class="block text-sm font-medium text-ink">
      Title <span class="font-normal text-ink-muted">(optional)</span>
    </label>
    <input
      id="review-title"
      type="text"
      name="title"
      maxlength="120"
      class="mt-1.5 w-full rounded-lg border border-border bg-surface px-3 py-2 text-sm text-ink focus:border-accent/50 focus:outline-none focus:ring-1 focus:ring-accent/30"
    />
  </div>

  <div class="mt-4">
    <label for="review-body" class="block text-sm font-medium text-ink">
      Your review
    </label>
    <textarea
      id="review-body"
      name="body"
      required
      rows="4"
      maxlength="5000"
      class="mt-1.5 w-full rounded-lg border border-border bg-surface px-3 py-2 text-sm text-ink focus:border-accent/50 focus:outline-none focus:ring-1 focus:ring-accent/30"
      placeholder="What did you like or dislike?"
    />
  </div>

  <div class="mt-4 grid gap-4 sm:grid-cols-2">
    <div>
      <label for="review-image-url" class="block text-sm font-medium text-ink">
        Image URL <span class="font-normal text-ink-muted">(optional)</span>
      </label>
      <input
        id="review-image-url"
        type="url"
        name="image_url"
        placeholder="https://…"
        class="mt-1.5 w-full rounded-lg border border-border bg-surface px-3 py-2 text-sm text-ink placeholder:text-ink-muted/60 focus:border-accent/50 focus:outline-none focus:ring-1 focus:ring-accent/30"
      />
    </div>
    <div>
      <label for="review-image-file" class="block text-sm font-medium text-ink">
        Or upload image <span class="font-normal text-ink-muted">(optional)</span>
      </label>
      <input
        id="review-image-file"
        type="file"
        name="image_file"
        accept="image/jpeg,image/png,image/webp,image/gif"
        class="mt-1.5 w-full text-sm text-ink-muted file:mr-3 file:rounded-lg file:border-0 file:bg-accent/15 file:px-3 file:py-2 file:text-sm file:font-medium file:text-accent"
      />
    </div>
  </div>

  <button
    type="submit"
    class="mt-6 rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-surface transition hover:bg-accent-dim"
  >
    Submit review
  </button>
</form>
