---
interface Props {
  current: "dashboard" | "users" | "products" | "logs";
}

const { current } = Astro.props;

const links = [
  { id: "dashboard" as const, href: "/admin", label: "Overview" },
  { id: "users" as const, href: "/admin/users", label: "Users" },
  { id: "products" as const, href: "/admin/products", label: "Products" },
  { id: "logs" as const, href: "/admin/logs", label: "System log" },
];
---

<nav class="mb-8 flex flex-wrap gap-2 border-b border-border pb-4" aria-label="Admin">
  {
    links.map((link) => (
      <a
        href={link.href}
        class:list={[
          "rounded-lg px-4 py-2 text-sm font-medium transition",
          current === link.id
            ? "bg-accent/15 text-accent ring-1 ring-accent/30"
            : "text-ink-muted hover:bg-surface-muted/50 hover:text-ink",
        ]}
        aria-current={current === link.id ? "page" : undefined}
      >
        {link.label}
      </a>
    ))
  }
</nav>
