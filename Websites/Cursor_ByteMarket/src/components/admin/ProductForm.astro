---
import FormField from "@/components/auth/FormField.astro";
import type { ProductWithCategory } from "@/lib/admin/products";

interface Props {
  product?: ProductWithCategory;
  categories: { id: number; name: string }[];
  action: string;
  submitLabel: string;
  actionName?: string;
}

const {
  product,
  categories,
  action,
  submitLabel,
  actionName = "update",
} = Astro.props;

const priceValue = product ? (product.priceCents / 100).toFixed(2) : "";
---

<form method="post" action={action} class="space-y-5 rounded-2xl border border-border bg-surface-raised p-6">
  <input type="hidden" name="action" value={actionName} />
  <FormField
    id="slug"
    name="slug"
    label="Slug"
    required
    value={product?.slug ?? ""}
    hint="Lowercase URL segment, e.g. rtx-4070-super"
  />
  <FormField id="name" name="name" label="Name" required value={product?.name ?? ""} />
  <div>
    <label for="description" class="mb-1.5 block text-sm font-medium text-ink">Description</label>
    <textarea
      id="description"
      name="description"
      rows="4"
      class="w-full rounded-lg border border-border bg-surface px-4 py-2.5 text-sm text-ink placeholder:text-ink-muted/60 transition focus:border-accent/50 focus:outline-none focus:ring-2 focus:ring-accent/20"
    >{product?.description ?? ""}</textarea>
  </div>
  <div class="grid gap-5 sm:grid-cols-2">
    <FormField
      id="price"
      name="price"
      label="Price (CAD)"
      type="number"
      step="0.01"
      min="0"
      required
      value={priceValue}
    />
    <FormField
      id="stock"
      name="stock"
      label="Stock"
      type="number"
      min="0"
      required
      value={product ? String(product.stock) : "0"}
    />
  </div>
  <div>
    <label for="categoryId" class="mb-1.5 block text-sm font-medium text-ink">Category</label>
    <select
      id="categoryId"
      name="categoryId"
      class="w-full rounded-lg border border-border bg-surface px-4 py-2.5 text-sm"
    >
      <option value="">None</option>
      {
        categories.map((c) => (
          <option value={c.id} selected={product?.categoryId === c.id}>
            {c.name}
          </option>
        ))
      }
    </select>
  </div>
  <FormField
    id="imageUrl"
    name="imageUrl"
    label="Image URL"
    type="url"
    value={product?.imageUrl ?? ""}
    placeholder="https://..."
  />
  <label class="flex items-center gap-3 text-sm">
    <input
      type="checkbox"
      name="featured"
      class="h-4 w-4 rounded border-border bg-surface text-accent focus:ring-accent/30"
      checked={product?.featured ?? false}
    />
    <span>Featured on landing page</span>
  </label>
  <button
    type="submit"
    class="w-full rounded-lg bg-accent py-2.5 text-sm font-medium text-surface transition hover:bg-accent-dim"
  >
    {submitLabel}
  </button>
</form>
