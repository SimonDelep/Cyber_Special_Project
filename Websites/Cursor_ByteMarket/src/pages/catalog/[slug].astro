---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ReviewForm from "@/components/catalog/ReviewForm.astro";
import ReviewList from "@/components/catalog/ReviewList.astro";
import { getCurrentUser } from "@/lib/auth";
import { formatPrice, getProductBySlug } from "@/lib/products";
import {
  getProductReviewStats,
  getReviewsForProduct,
  getUserReviewForProduct,
} from "@/lib/reviews";
import { formatAverageRating, starsForRating } from "@/lib/stars";

export const prerender = false;

const slug = Astro.params.slug?.trim();
if (!slug) {
  return Astro.redirect("/catalog");
}

const flashError = Astro.url.searchParams.get("error");
const flashSuccess = Astro.url.searchParams.get("success");

const authUser = getCurrentUser(Astro.cookies);

let product: Awaited<ReturnType<typeof getProductBySlug>> = null;
let reviews: Awaited<ReturnType<typeof getReviewsForProduct>> = [];
let stats: Awaited<ReturnType<typeof getProductReviewStats>> = {
  count: 0,
  averageRating: null,
};
let userAlreadyReviewed = false;
let dbError: string | null = null;

try {
  product = await getProductBySlug(slug);
  if (product) {
    [reviews, stats] = await Promise.all([
      getReviewsForProduct(product.id),
      getProductReviewStats(product.id),
    ]);
    if (authUser) {
      const existing = await getUserReviewForProduct(product.id, authUser.id);
      userAlreadyReviewed = !!existing;
    }
  }
} catch (err) {
  dbError =
    err instanceof Error
      ? err.message
      : "Database unavailable. Run npm run db:setup.";
}

if (!product && !dbError) {
  return Astro.redirect("/catalog?error=Product+not+found");
}
---

{
  product && (
    <BaseLayout
      title={`${product.name} — ByteMarket`}
      description={product.description ?? `Buy ${product.name} at ByteMarket.`}
    >
      <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10">
        <nav class="text-sm text-ink-muted" aria-label="Breadcrumb">
          <a href="/catalog" class="hover:text-accent">
            Catalog
          </a>
          <span class="mx-2">/</span>
          <span class="text-ink">{product.name}</span>
        </nav>

        {flashError && (
          <div
            class="mt-4 rounded-lg border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-200"
            role="alert"
          >
            {flashError}
          </div>
        )}
        {flashSuccess && (
          <div
            class="mt-4 rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-200"
            role="status"
          >
            {flashSuccess}
          </div>
        )}
        {dbError && (
          <div
            class="mt-4 rounded-lg border border-amber-500/30 bg-amber-500/10 px-4 py-3 text-sm text-amber-200"
            role="alert"
          >
            {dbError}
          </div>
        )}

        <div class="mt-6 grid gap-10 lg:grid-cols-2">
          <div class="overflow-hidden rounded-xl border border-border bg-surface-raised">
            {
              product.imageUrl ? (
                <img
                  src={product.imageUrl}
                  alt={product.name}
                  class="aspect-square w-full object-cover"
                  width="640"
                  height="640"
                />
              ) : (
                <div class="flex aspect-square items-center justify-center bg-surface-muted/50 font-mono text-6xl text-ink-muted/40">
                  {product.categorySlug?.slice(0, 2).toUpperCase() ?? "BM"}
                </div>
              )
            }
          </div>

          <div>
            {
              product.categoryName && (
                <p class="text-xs font-medium uppercase tracking-wide text-accent">
                  {product.categoryName}
                </p>
              )
            }
            <h1 class="mt-1 text-3xl font-bold tracking-tight">
              {product.name}
            </h1>

            <div class="mt-3 flex flex-wrap items-center gap-3">
              {
                stats.count > 0 && stats.averageRating != null ? (
                  <>
                    <span
                      class="font-mono text-lg text-amber-300/90"
                      aria-hidden="true"
                    >
                      {starsForRating(Math.round(stats.averageRating))}
                    </span>
                    <span class="text-sm text-ink-muted">
                      {formatAverageRating(stats.averageRating)} / 5 ·{" "}
                      {stats.count} review{stats.count === 1 ? "" : "s"}
                    </span>
                  </>
                ) : (
                  <span class="text-sm text-ink-muted">No reviews yet</span>
                )
              }
            </div>

            <p class="mt-4 text-2xl font-semibold text-ink">
              {formatPrice(product.priceCents)}
            </p>
            <p class="mt-1 text-sm text-ink-muted">
              {
                product.stock > 0
                  ? `${product.stock} in stock`
                  : "Out of stock"
              }
            </p>
            <p class="mt-6 text-ink-muted leading-relaxed">
              {product.description}
            </p>

            <div class="mt-8 flex flex-wrap gap-3">
              {
                product.stock > 0 ? (
                  <button
                    type="button"
                    data-add-to-cart
                    data-product-id={product.id}
                    data-product-slug={product.slug}
                    data-product-name={product.name}
                    data-product-price={product.priceCents}
                    class="rounded-lg bg-accent px-6 py-3 text-sm font-semibold text-surface transition hover:bg-accent-dim"
                  >
                    Add to cart
                  </button>
                ) : (
                  <button
                    type="button"
                    disabled
                    class="cursor-not-allowed rounded-lg border border-border px-6 py-3 text-sm text-ink-muted"
                  >
                    Out of stock
                  </button>
                )
              }
              <a
                href="/cart"
                class="rounded-lg border border-border px-6 py-3 text-sm font-medium text-ink transition hover:border-ink-muted/50"
              >
                View cart
              </a>
            </div>
          </div>
        </div>

        <section class="mt-16 border-t border-border pt-12" id="reviews">
          <h2 class="text-2xl font-bold tracking-tight">Customer reviews</h2>

          {
            authUser ? (
              userAlreadyReviewed ? (
                <p class="mt-4 rounded-lg border border-border bg-surface-raised px-4 py-3 text-sm text-ink-muted">
                  You have already reviewed this product. Thank you for your
                  feedback.
                </p>
              ) : (
                <div class="mt-6">
                  <ReviewForm productSlug={product.slug} />
                </div>
              )
            ) : (
              <p class="mt-4 text-sm text-ink-muted">
                <a href={`/login?redirect=${encodeURIComponent(`/catalog/${product.slug}`)}`} class="font-medium text-accent hover:underline">
                  Sign in
                </a>{" "}
                to write a review.
              </p>
            )
          }

          <div class="mt-8">
            <ReviewList reviews={reviews} />
          </div>
        </section>
      </div>
    </BaseLayout>
  )
}
