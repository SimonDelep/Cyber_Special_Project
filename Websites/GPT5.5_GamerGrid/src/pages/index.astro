---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductCatalog from '@/components/ProductCatalog.astro';
import PokemonShowcase from '@/components/PokemonShowcase.astro';
import { getFeaturedProducts } from '@/lib/products';
import { fetchPokemonShowcase } from '@/lib/pokemon';

let products = await getFeaturedProducts().catch(() => []);

let pokemon: Awaited<ReturnType<typeof fetchPokemonShowcase>> = [];
let pokemonError: string | null = null;
try {
  pokemon = await fetchPokemonShowcase();
} catch {
  pokemonError = 'PokéAPI is unreachable. Check your network connection and try again.';
}
---

<BaseLayout>
  <section class="relative overflow-hidden border-b border-white/10">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-volt-900/50 via-slate-950 to-slate-950"
      aria-hidden="true"
    />
    <div class="relative mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
      <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-volt-500/30 bg-volt-950/50 px-3 py-1 text-xs font-medium uppercase tracking-wider text-volt-300">
        <span class="h-1.5 w-1.5 rounded-full bg-stream-400" />
        Quiet by design
      </p>
      <h1 class="max-w-3xl text-4xl font-bold leading-tight tracking-tight text-white sm:text-5xl lg:text-6xl">
        Breathe cleaner. Hydrate smarter.
        <span class="block bg-gradient-to-r from-volt-400 to-stream-400 bg-clip-text text-transparent">
          Powered by VoltStream.
        </span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-400">
        Shop ultra-quiet portable air purifiers, precision desktop humidifiers, and smart water bottles with built-in UV sterilization — engineered for bedrooms, desks, and life on the go.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href="/catalog"
          class="inline-flex rounded-full bg-volt-600 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-volt-900/50 hover:bg-volt-500 transition-colors"
        >
          Browse catalog
        </a>
        <a
          href="#categories"
          class="inline-flex rounded-full border border-white/20 px-6 py-3 text-sm font-semibold text-slate-200 hover:bg-white/5 transition-colors"
        >
          View categories
        </a>
      </div>
      <dl class="mt-14 grid grid-cols-2 gap-6 sm:grid-cols-4">
        <div>
          <dt class="text-2xl font-bold text-white">&lt;20 dB</dt>
          <dd class="mt-1 text-sm text-slate-500">Sleep-mode noise floor</dd>
        </div>
        <div>
          <dt class="text-2xl font-bold text-white">HEPA-13</dt>
          <dd class="mt-1 text-sm text-slate-500">Portable filtration</dd>
        </div>
        <div>
          <dt class="text-2xl font-bold text-white">UV-C</dt>
          <dd class="mt-1 text-sm text-slate-500">Cap sterilization</dd>
        </div>
        <div>
          <dt class="text-2xl font-bold text-white">USB-C</dt>
          <dd class="mt-1 text-sm text-slate-500">Travel-ready power</dd>
        </div>
      </dl>
    </div>
  </section>

  <section id="categories" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <div class="mb-10 max-w-2xl">
      <h2 class="text-2xl font-bold text-white sm:text-3xl">Three pillars of wellness</h2>
      <p class="mt-3 text-slate-400">
        Every VoltStream device is tuned for low noise, low maintenance, and measurable impact on your daily environment.
      </p>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      <article class="rounded-2xl border border-white/10 bg-gradient-to-b from-slate-900/80 to-slate-950 p-6">
        <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-volt-600/20 text-volt-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3c-1.5 3-4.5 4.5-4.5 9a4.5 4.5 0 109 0c0-4.5-3-6-4.5-9z" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-white">Air Purifiers</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-400">
          Ultra-quiet portable units with HEPA filtration for bedrooms, nurseries, and hotel rooms.
        </p>
      </article>
      <article class="rounded-2xl border border-white/10 bg-gradient-to-b from-slate-900/80 to-slate-950 p-6">
        <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-stream-500/20 text-stream-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 2v6m0 0c3 0 5 2 5 5m-5-5c-3 0-5 2-5 5m5 5v5m-4-3c-2 1-4 1-6 0" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-white">Desktop Humidifiers</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-400">
          Precise mist output and night-friendly LEDs for healthier air at your workspace.
        </p>
      </article>
      <article class="rounded-2xl border border-white/10 bg-gradient-to-b from-slate-900/80 to-slate-950 p-6">
        <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-volt-500/20 text-volt-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5-2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-white">Smart UV Bottles</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-400">
          Track hydration and sterilize your cap with a 60-second UV-C cycle after each refill.
        </p>
      </article>
    </div>
  </section>

  <PokemonShowcase pokemon={pokemon} error={pokemonError} />

  <section id="products" class="border-t border-white/10 bg-slate-900/30">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <div class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-xs font-medium uppercase tracking-wider text-volt-400">Catalog</p>
          <h2 class="mt-1 text-2xl font-bold text-white sm:text-3xl">Featured products</h2>
          <p class="mt-2 text-slate-400">
            A selection of our bestsellers. Use search and filters on the full catalog.
          </p>
        </div>
        <a
          href="/catalog"
          class="inline-flex rounded-full border border-volt-500/30 bg-volt-950/50 px-4 py-2 text-sm font-medium text-volt-300 hover:bg-volt-500/20"
        >
          Full catalog →
        </a>
      </div>

      {products.length > 0 ? (
        <ProductCatalog products={products} />
      ) : (
        <div class="rounded-2xl border border-amber-500/30 bg-amber-950/30 p-6 text-amber-100">
          <p class="font-medium">Database not seeded yet</p>
          <p class="mt-2 text-sm text-amber-200/80">
            Run <code class="rounded bg-black/30 px-1.5 py-0.5 font-mono text-xs">npm run db:seed</code> then refresh this page.
          </p>
        </div>
      )}
    </div>
  </section>

  <section id="why" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <div class="rounded-3xl border border-volt-500/20 bg-gradient-to-br from-volt-950/80 via-slate-900 to-slate-950 p-8 sm:p-12">
      <h2 class="text-2xl font-bold text-white sm:text-3xl">Why VoltStream?</h2>
      <ul class="mt-8 grid gap-6 sm:grid-cols-2">
        <li class="flex gap-4">
          <span class="mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-volt-600 text-sm font-bold text-white">1</span>
          <div>
            <p class="font-medium text-white">Whisper-quiet engineering</p>
            <p class="mt-1 text-sm text-slate-400">Acoustic dampening and low-RPM fans keep night mode under 20 dB.</p>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-volt-600 text-sm font-bold text-white">2</span>
          <div>
            <p class="font-medium text-white">Lab-verified filtration</p>
            <p class="mt-1 text-sm text-slate-400">HEPA-13 and carbon stages tested for smoke, pollen, and VOC reduction.</p>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-volt-600 text-sm font-bold text-white">3</span>
          <div>
            <p class="font-medium text-white">UV you can trust</p>
            <p class="mt-1 text-sm text-slate-400">Smart bottles run a sealed UV-C cycle — no exposed lamps, no guesswork.</p>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-volt-600 text-sm font-bold text-white">4</span>
          <div>
            <p class="font-medium text-white">Built for real desks</p>
            <p class="mt-1 text-sm text-slate-400">Compact footprints, USB-C power, and filters you can swap in seconds.</p>
          </div>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>
