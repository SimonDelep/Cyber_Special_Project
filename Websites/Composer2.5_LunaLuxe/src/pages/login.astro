---
export const prerender = false;

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import AuthCard from '@/components/AuthCard.astro';
import Alert from '@/components/Alert.astro';
import FormField from '@/components/FormField.astro';

const error = Astro.url.searchParams.get('error');
const redirect = Astro.url.searchParams.get('redirect') ?? '/profile';
---

<BaseLayout title="Login — LunaLuxe">
  <Header />

  <main class="flex min-h-screen items-center justify-center px-6 pb-24 pt-28">
    <AuthCard title="Welcome back" subtitle="Sign in to manage your profile and orders.">
      <Alert type="error" message={error} />

      <form action="/api/auth/login" method="post" class="space-y-5">
        <input type="hidden" name="redirect" value={redirect} />
        <FormField label="Username" name="username" required placeholder="your_username" />
        <FormField label="Password" name="password" type="password" required />
        <button
          type="submit"
          class="w-full rounded-full bg-luna-800 py-3 text-sm font-semibold text-luna-50 transition-colors hover:bg-luna-700"
        >
          Sign in
        </button>
      </form>

      <p class="mt-6 text-center text-sm text-luna-600">
        No account yet?
        <a href="/register" class="font-medium text-lavender-600 hover:text-lavender-500">Create one</a>
      </p>
    </AuthCard>
  </main>

  <Footer />
</BaseLayout>
