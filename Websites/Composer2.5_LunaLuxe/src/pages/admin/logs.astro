---
export const prerender = false;

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import AdminTabs from '@/components/admin/AdminTabs.astro';
import LogFilters from '@/components/admin/LogFilters.astro';
import SystemLogTable from '@/components/admin/SystemLogTable.astro';
import { getSystemLogs, getLogStats } from '@/lib/monitoring/logger';
import type { LogSeverity } from '@/db/schema';

const currentUser = Astro.locals.user;
if (!currentUser) {
  return Astro.redirect(`/login?redirect=${encodeURIComponent(Astro.url.pathname)}`);
}

const params = Astro.url.searchParams;
const eventType = params.get('eventType') ?? '';
const severityParam = params.get('severity') ?? '';
const username = params.get('username') ?? '';

const validSeverities: LogSeverity[] = ['info', 'success', 'warning', 'error'];
const severity = validSeverities.includes(severityParam as LogSeverity)
  ? (severityParam as LogSeverity)
  : undefined;

const [logs, stats] = await Promise.all([
  getSystemLogs({
    eventType: eventType || undefined,
    severity,
    username: username || undefined,
    limit: 200,
  }),
  getLogStats(),
]);
---

<BaseLayout title="System Logs — LunaLuxe Admin">
  <Header />

  <main class="mx-auto max-w-6xl px-6 pb-24 pt-28">
    <div class="mb-8">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-lavender-500">Monitoring</p>
      <h1 class="mt-2 font-serif text-4xl font-semibold text-luna-900">System logs</h1>
      <p class="mt-2 text-sm text-luna-600">
        Internal audit trail for authentication, profile changes, transactions, and admin actions.
      </p>
    </div>

    <AdminTabs activeTab="logs" />

    <!-- Stats -->
    <div class="mb-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      <div class="rounded-xl border border-luna-200 bg-white p-4 shadow-sm">
        <p class="text-xs font-medium uppercase tracking-wider text-luna-500">Total events</p>
        <p class="mt-1 text-2xl font-semibold text-luna-900">{stats.total}</p>
      </div>
      <div class="rounded-xl border border-luna-200 bg-white p-4 shadow-sm">
        <p class="text-xs font-medium uppercase tracking-wider text-luna-500">Last 24h</p>
        <p class="mt-1 text-2xl font-semibold text-luna-900">{stats.last24h}</p>
      </div>
      <div class="rounded-xl border border-amber-200 bg-amber-50/50 p-4 shadow-sm">
        <p class="text-xs font-medium uppercase tracking-wider text-amber-700">Failed logins (24h)</p>
        <p class="mt-1 text-2xl font-semibold text-amber-900">{stats.failedLogins24h}</p>
      </div>
      <div class="rounded-xl border border-luna-200 bg-white p-4 shadow-sm">
        <p class="text-xs font-medium uppercase tracking-wider text-luna-500">Checkouts (24h)</p>
        <p class="mt-1 text-2xl font-semibold text-luna-900">{stats.checkouts24h}</p>
      </div>
      <div class="rounded-xl border border-luna-200 bg-white p-4 shadow-sm">
        <p class="text-xs font-medium uppercase tracking-wider text-luna-500">Profile changes (24h)</p>
        <p class="mt-1 text-2xl font-semibold text-luna-900">{stats.profileChanges24h}</p>
      </div>
    </div>

    <div class="mb-6">
      <LogFilters
        eventType={eventType}
        severity={severityParam}
        username={username}
        resultCount={logs.length}
      />
    </div>

    <SystemLogTable logs={logs} />

    <p class="mt-6 text-center">
      <a href="/admin" class="text-sm font-medium text-lavender-600 hover:text-lavender-500">
        ← Back to admin panel
      </a>
    </p>
  </main>

  <Footer />
</BaseLayout>
