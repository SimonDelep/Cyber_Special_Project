---
export const prerender = false;

import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import AuthCard from '@/components/AuthCard.astro';
import Alert from '@/components/Alert.astro';
import FormField from '@/components/FormField.astro';

const error = Astro.url.searchParams.get('error');
const redirect = Astro.url.searchParams.get('redirect') ?? '/profile';
---

<BaseLayout title="Register — LunaLuxe">
  <Header />

  <main class="flex min-h-screen items-center justify-center px-6 pb-24 pt-28">
    <AuthCard title="Create account" subtitle="Join LunaLuxe for a personalized sleep experience.">
      <Alert type="error" message={error} />

      <form action="/api/auth/register" method="post" class="space-y-5">
        <input type="hidden" name="redirect" value={redirect} />
        <FormField label="Username" name="username" required placeholder="letters, numbers, underscore" />
        <FormField label="Display name" name="displayName" required placeholder="How we'll greet you" />
        <FormField label="Email" name="email" type="email" required />
        <FormField label="Password" name="password" type="password" required hint="At least 8 characters" />
        <FormField label="Confirm password" name="confirmPassword" type="password" required />
        <button
          type="submit"
          class="w-full rounded-full bg-luna-800 py-3 text-sm font-semibold text-luna-50 transition-colors hover:bg-luna-700"
        >
          Create account
        </button>
      </form>

      <p class="mt-6 text-center text-sm text-luna-600">
        Already registered?
        <a href="/login" class="font-medium text-lavender-600 hover:text-lavender-500">Sign in</a>
      </p>
    </AuthCard>
  </main>

  <Footer />
</BaseLayout>
