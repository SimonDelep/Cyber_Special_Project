---
import { fetchSleepWeather } from '@/lib/api/open-meteo';
import { fetchDailyAdvice } from '@/lib/api/advice-slip';

const [weather, advice] = await Promise.all([fetchSleepWeather(), fetchDailyAdvice()]);
---

<section class="border-y border-luna-200 bg-gradient-to-br from-luna-100/80 via-white to-lavender-100/30 py-16">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mb-10 text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-lavender-500">Live insights</p>
      <h2 class="mt-3 font-serif text-3xl font-semibold text-luna-900 md:text-4xl">
        Tonight's sleep guide
      </h2>
      <p class="mx-auto mt-3 max-w-xl text-sm text-luna-600">
        Real-time data from external APIs, curated for better rest.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      <!-- Open-Meteo weather API -->
      <article class="rounded-2xl border border-luna-200 bg-white p-6 shadow-sm">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-luna-500">Sleep climate</p>
            <h3 class="mt-1 font-serif text-xl font-semibold text-luna-900">
              {weather ? weather.city : 'Montréal'}
            </h3>
          </div>
          <span class="rounded-full bg-luna-100 px-3 py-1 text-[10px] font-semibold uppercase tracking-wider text-luna-600">
            Open-Meteo API
          </span>
        </div>

        {weather ? (
          <>
            <p class="mt-4 text-3xl font-semibold text-luna-900">
              {Math.round(weather.tempMin)}{weather.unit}
              <span class="mx-1 text-luna-400">–</span>
              {Math.round(weather.tempMax)}{weather.unit}
            </p>
            <p class="mt-1 text-xs text-luna-500">
              Overnight low / daytime high · {new Date(weather.date).toLocaleDateString('en-CA', { weekday: 'long', month: 'long', day: 'numeric' })}
            </p>
            <p class="mt-4 text-sm leading-relaxed text-luna-700">{weather.sleepTip}</p>
            <a href="/catalog?category=Bamboo+Bed+Sheets" class="mt-4 inline-block text-sm font-medium text-lavender-600 hover:text-lavender-500">
              Shop thermoregulating sheets →
            </a>
          </>
        ) : (
          <p class="mt-4 text-sm text-luna-500">
            Weather data is temporarily unavailable. Our bamboo sheets adapt to any season.
          </p>
        )}
      </article>

      <!-- Advice Slip API -->
      <article class="rounded-2xl border border-luna-200 bg-white p-6 shadow-sm">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-luna-500">Daily wisdom</p>
            <h3 class="mt-1 font-serif text-xl font-semibold text-luna-900">Restful thought</h3>
          </div>
          <span class="rounded-full bg-luna-100 px-3 py-1 text-[10px] font-semibold uppercase tracking-wider text-luna-600">
            {advice.source === 'advice-slip' ? 'Advice Slip API' : 'LunaLuxe'}
          </span>
        </div>

        <blockquote class="mt-4 border-l-4 border-lavender-400 pl-4">
          <p class="font-serif text-lg italic leading-relaxed text-luna-800">
            "{advice.advice}"
          </p>
        </blockquote>

        <p class="mt-4 text-xs text-luna-500">
          {advice.source === 'advice-slip'
            ? `Fetched live from adviceslip.com · tip #${advice.id}`
            : 'Curated sleep wisdom while the advice service reconnects.'}
        </p>
      </article>
    </div>
  </div>
</section>
