---
import { EVENT_TYPE_LABELS } from '@/lib/monitoring/events';
import { logSeverities } from '@/db/schema';

interface Props {
  eventType: string;
  severity: string;
  username: string;
  resultCount: number;
}

const { eventType, severity, username, resultCount } = Astro.props;

const inputClass =
  'w-full rounded-xl border border-luna-200 bg-white px-4 py-2.5 text-sm text-luna-900 outline-none focus:border-lavender-400 focus:ring-2 focus:ring-lavender-400/20';
---

<form method="get" action="/admin/logs" class="rounded-2xl border border-luna-200 bg-white p-6 shadow-sm">
  <div class="mb-4 flex items-center justify-between">
    <h2 class="font-serif text-lg font-semibold text-luna-900">Filter logs</h2>
    <span class="text-sm text-luna-500">{resultCount} event{resultCount !== 1 ? 's' : ''}</span>
  </div>

  <div class="grid gap-4 md:grid-cols-3">
    <div>
      <label for="eventType" class="block text-sm font-medium text-luna-700">Event type</label>
      <select id="eventType" name="eventType" class={inputClass}>
        <option value="">All events</option>
        {Object.entries(EVENT_TYPE_LABELS).map(([value, label]) => (
          <option value={value} selected={eventType === value}>{label}</option>
        ))}
      </select>
    </div>

    <div>
      <label for="severity" class="block text-sm font-medium text-luna-700">Severity</label>
      <select id="severity" name="severity" class={inputClass}>
        <option value="">All severities</option>
        {logSeverities.map((s) => (
          <option value={s} selected={severity === s} class="capitalize">{s}</option>
        ))}
      </select>
    </div>

    <div>
      <label for="username" class="block text-sm font-medium text-luna-700">User / message</label>
      <input
        type="search"
        id="username"
        name="username"
        value={username}
        placeholder="Search username or message…"
        class={inputClass}
      />
    </div>
  </div>

  <div class="mt-4 flex gap-3">
    <button
      type="submit"
      class="rounded-full bg-luna-800 px-6 py-2.5 text-sm font-semibold text-luna-50 hover:bg-luna-700"
    >
      Apply
    </button>
    <a
      href="/admin/logs"
      class="rounded-full border border-luna-300 px-6 py-2.5 text-sm font-medium text-luna-700 hover:bg-luna-100"
    >
      Clear
    </a>
  </div>
</form>
