<footer id="about" class="border-t border-luna-200 bg-luna-100/50">
  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid gap-12 md:grid-cols-3">
      <div>
        <p class="font-serif text-xl font-semibold text-luna-900">LunaLuxe</p>
        <p class="mt-3 text-sm leading-relaxed text-luna-600">
          Curated sleep essentials designed to transform your bedroom into a sanctuary of calm, comfort, and quiet luxury.
        </p>
      </div>

      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-luna-500">Collections</p>
