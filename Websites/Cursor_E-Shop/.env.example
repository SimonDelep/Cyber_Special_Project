# Matches docker-compose.yml (npm run db:up)
DATABASE_URL="postgresql://eshop:eshop@localhost:5432/eshop?schema=public"

# Auth.js / NextAuth v5 (JWT sessions with credentials provider)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Legacy aliases (optional; AUTH_* takes precedence)
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
